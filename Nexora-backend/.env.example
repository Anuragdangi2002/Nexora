PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Firebase Configuration (Optional - Omit or leave empty to use file-based local db.json)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Database Mode (Set to "true" to force local file-based database db.json)
USE_MOCK_DB=true

# Initial Admin Seeding Configuration (Used by npm run seed:admin)
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_USERNAME=NexoraAdmin

# SMTP Configuration (Optional - Required only to send real emails via SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
